+
+export function isHostedPreview(value: string): boolean {
+  return /^\/preview\/\d+\/$/.test(value);
+}
+
+export function hostedPreviewUrl(baseValue: string, requestedPath: string, origin: string): URL {
+  if (!isHostedPreview(baseValue) || requestedPath.startsWith("//") || /^[a-z][a-z0-9+.-]*:/i.test(requestedPath)) throw new Error("Invalid hosted preview path");
