            "title": "Attempt Id",
            "type": "string"
          },
          "filename": {
            "maxLength": 255,
            "minLength": 1,
            "title": "Filename",
            "type": "string"
          },
          "content_type": {
            "enum": [
              "image/png",
              "image/jpeg",
              "image/webp",
              "image/avif"
            ],
            "title": "Content Type",
            "type": "string"
          },
          "size_bytes": {
            "maximum": 20971520,
            "minimum": 1,
            "title": "Size Bytes",
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Sha256",
            "type": "string"
          }
        },
        "required": [
          "input_session_id",
          "attempt_id",
          "filename",
          "content_type",
          "size_bytes",
          "sha256"
        ],
